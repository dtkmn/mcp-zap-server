# Supply two different 64-character hexadecimal keys (32 random bytes each)
# from your secret manager, following the deployment guide. Keep .env mode 0600.
# Empty values deliberately prevent startup until real credentials are supplied.
MCP_API_KEY=
ZAP_API_KEY=

# HTTP crawl limits are independent. 0 means unlimited.
ZAP_SPIDER_MAX_DEPTH=10
ZAP_SPIDER_MAX_CHILDREN=10
